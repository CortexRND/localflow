          {"name": "prompts-query", "req": {"jsonrpc": "2.0", "id": 22, "method": "tools/call", "params": {"name": "search_prompts", "arguments": {"query": "redis"}}},
           "expect": [{"path": "result.structuredContent.count", "eq": 2},
                      {"path": "result.structuredContent.results.*.title", "set_eq": ["Migrate session storage to Redis", "Update deploy docs for Redis sessions"]}]},
          {"name": "prompts-query-body", "req": {"jsonrpc": "2.0", "id": 23, "method": "tools/call", "params": {"name": "search_prompts", "arguments": {"query": "expiry runbook"}}},
           "expect": [{"path": "result.structuredContent.results.0.title", "eq": "Audit TLS certificates"}]},
          {"name": "prompts-limit", "req": {"jsonrpc": "2.0", "id": 24, "method": "tools/call", "params": {"name": "search_prompts", "arguments": {"limit": 1}}},
           "expect": [{"path": "result.structuredContent.count", "eq": 1}]},
          {"name": "get-prompt", "req": {"jsonrpc": "2.0", "id": 25, "method": "tools/call", "params": {"name": "get_prompt", "arguments": {"id": "{{prompt:Migrate session storage to Redis}}"}}},
           "expect": [{"path": "result.structuredContent.status", "eq": "approved"}, {"path": "result.structuredContent.title", "eq": "Migrate session storage to Redis"},
                      {"path": "result.structuredContent.body", "contains": "Redis before the pilot launch"}, {"path": "result.structuredContent.meeting", "eq": "Platform sync"}]},
          {"name": "get-prompt-missing", "req": {"jsonrpc": "2.0", "id": 26, "method": "tools/call", "params": {"name": "get_prompt", "arguments": {"id": "deadbeef"}}},
           "expect": [{"path": "result.isError", "eq": true}, {"path": "result.content.0.text", "contains": "deadbeef"}]}
        ],
        "errors": [
          {"name": "malformed-json", "raw": "{\"jsonrpc\": \"2.0\", \"id\": 30, \"method\": ", "expect": [{"path": "error.code", "eq": -32700}, {"path": "id", "eq": null}]},
          {"name": "unknown-method", "req": {"jsonrpc": "2.0", "id": 31, "method": "resources/list"}, "expect": [{"path": "error.code", "eq": -32601}, {"path": "id", "eq": 31}]},
          {"name": "unknown-tool", "req": {"jsonrpc": "2.0", "id": 32, "method": "tools/call", "params": {"name": "delete_dictation", "arguments": {"id": 1}}},
           "expect": [{"path": "error.code", "eq": -32602}]},
          {"name": "missing-required-arg", "req": {"jsonrpc": "2.0", "id": 33, "method": "tools/call", "params": {"name": "get_dictation", "arguments": {}}},
           "expect": [{"path": "error.code", "eq": -32602}]},
          {"name": "unknown-arg", "req": {"jsonrpc": "2.0", "id": 34, "method": "tools/call", "params": {"name": "search_dictations", "arguments": {"sql": "DROP TABLE dictations"}}},
           "expect": [{"path": "error.code", "eq": -32602}]},
          {"name": "wrong-type-arg", "req": {"jsonrpc": "2.0", "id": 35, "method": "tools/call", "params": {"name": "get_dictation", "arguments": {"id": "1"}}},
           "expect": [{"path": "error.code", "eq": -32602}]},
          {"name": "bad-enum-arg", "req": {"jsonrpc": "2.0", "id": 36, "method": "tools/call", "params": {"name": "search_dictations", "arguments": {"kind": "everything"}}},
           "expect": [{"path": "error.code", "eq": -32602}]},
          {"name": "params-not-object", "req": {"jsonrpc": "2.0", "id": 37, "method": "tools/call", "params": [1, 2]},
           "expect": [{"path": "error.code", "eq": -32602}]},
          {"name": "server-still-alive", "req": {"jsonrpc": "2.0", "id": 38, "method": "ping"}, "expect": [{"path": "result", "eq": {}}]}
        ],
        "disabled": [
          {"name": "disabled-search", "req": {"jsonrpc": "2.0", "id": 40, "method": "tools/call", "params": {"name": "search_dictations", "arguments": {"query": "kubernetes"}}},
           "expect": [{"path": "result.isError", "eq": true}, {"path": "result.content.0.text", "contains": "history is disabled"},
                      {"raw_not_contains": "canary"}, {"path": "result.structuredContent", "exists": false}]},
          {"name": "disabled-get", "req": {"jsonrpc": "2.0", "id": 41, "method": "tools/call", "params": {"name": "get_dictation", "arguments": {"id": 1}}},
           "expect": [{"path": "result.isError", "eq": true}, {"path": "result.content.0.text", "contains": "history is disabled"},
                      {"raw_not_contains": "canary"}]},
          {"name": "disabled-prompts-still-work", "req": {"jsonrpc": "2.0", "id": 42, "method": "tools/call", "params": {"name": "search_prompts", "arguments": {}}},
           "expect": [{"path": "result.structuredContent.count", "eq": 3}]}
        ]
      },
      "cells": [
        {"id": "mcp-protocol", "kind": "mcp", "gate": "P1", "groups": ["protocol"], "score_expects": true, "history_enabled": true},
        {"id": "mcp-tools", "kind": "mcp", "gate": "P2", "groups": ["tools"], "score_expects": true, "history_enabled": true},
        {"id": "mcp-readonly", "kind": "mcp", "gate": "P3", "groups": ["protocol", "tools", "errors"], "score_expects": false, "history_enabled": true},
        {"id": "mcp-history-disabled", "kind": "mcp", "gate": "P3", "groups": ["disabled"], "score_expects": true, "history_enabled": false},
        {"id": "mcp-errors", "kind": "mcp", "gate": "P4", "groups": ["errors"], "score_expects": true, "history_enabled": true}
      ]
    },

    "settings_api": {
      "cells": [
        {"id": "set-auth", "kind": "auth", "gate": "S1",
         "unauthenticated": [
           {"method": "get", "path": "/api/config"},
           {"method": "get", "path": "/api/status"},
           {"method": "put", "path": "/api/config", "json": {"cleanup": {"level": "none"}}},
           {"method": "post", "path": "/api/recall", "json": {"question": "what did I say", "llm": false}},
           {"method": "post", "path": "/meeting/start", "json": {"title": "Unauthorized"}},
           {"method": "get", "path": "/meeting/status"},
           {"method": "post", "path": "/transcribe", "upload": true},
           {"method": "get", "path": "/prompts"},
           {"method": "get", "path": "/api/secrets"}
         ],
         "wrong_token": [
           {"method": "get", "path": "/api/config"},
           {"method": "post", "path": "/api/recall", "json": {"question": "what did I say", "llm": false}}
         ],
         "foreign_host": [{"method": "get", "path": "/api/config"}],
         "public": [{"method": "get", "path": "/healthz"}],
         "authenticated": [
           {"method": "get", "path": "/api/config"},
           {"method": "get", "path": "/api/status"},
           {"method": "post", "path": "/api/recall", "json": {"question": "what did I say", "llm": false}}
         ]},
        {"id": "set-config-roundtrip", "kind": "config_roundtrip", "gate": "S2",
         "update": {"cleanup": {"level": "medium", "style_personal": "excited"}, "dictation": {"spoken_symbols": false}, "history": {"keep_audio_clips": 3}},
         "restart_update": {"hotkey": {"sounds": true}},
         "restart_expected": ["hotkey.sounds"],
         "invalid": [
           {"name": "bad-enum", "body": {"cleanup": {"level": "extreme"}}},
           {"name": "unknown-section", "body": {"nope": {"x": 1}}},
           {"name": "unknown-key", "body": {"cleanup": {"nope": 1}}},
           {"name": "wrong-type", "body": {"server": {"port": "abc"}}},
           {"name": "foreign-key-ref", "body": {"llm": {"api_key_ref": "fireworks_api_key"}}}
         ]},
        {"id": "set-migrate-v1", "kind": "migrate", "gate": "S3",
         "cases": [
           {"name": "full",
            "v1": {"ollama_url": "http://127.0.0.1:11434", "ollama_model": "gemma4:4b", "stt_backend": "mlx", "model_size": "small",
                   "hotkey": "alt_r", "cleanup_level": "medium", "vault_path": "~/vault", "fireworks_api_key": "fw-SIM-FAKE-0000-not-a-real-key",
                   "favorite_color": "teal"},
            "expected": {"config_version": 2, "llm": {"base_url": "http://127.0.0.1:11434", "model": "gemma4:4b"},
                         "stt": {"provider": "mlx-whisper", "model": "small"}, "hotkey": {"key": "alt_r"},
                         "cleanup": {"level": "medium"}, "meetings": {"vault_path": "~/vault"}},
            "expected_key": "fw-SIM-FAKE-0000-not-a-real-key",
            "config_fields": {"llm_base_url": "http://127.0.0.1:11434", "llm_model": "gemma4:4b", "stt_backend": "mlx-whisper",
                              "model_size": "small", "hotkey": "alt_r", "cleanup_level": "medium", "vault_path": "~/vault"},
            "legacy_file": true},
           {"name": "no-key",
            "v1": {"stt_backend": "faster-whisper", "server_port": 9000, "history_enabled": false, "sounds_enabled": false, "llm_provider": "ollama"},
            "expected": {"config_version": 2, "stt": {"provider": "faster-whisper"}, "server": {"port": 9000},
                         "history": {"enabled": false}, "hotkey": {"sounds": false}, "llm": {"provider": "ollama"}},
            "expected_key": null,
            "config_fields": {"stt_backend": "faster-whisper", "server_port": 9000, "history_enabled": false, "sounds_enabled": false, "llm_provider": "ollama"},
            "legacy_file": false}
         ]},
        {"id": "set-validator", "kind": "validator", "gate": "S4", "platform": "linux", "templates": ["general", "standup", "one-on-one"],
         "cases": [
           {"key": "cleanup_level", "value": "Medium", "ok": "medium"},
           {"key": "sounds_enabled", "value": "off", "ok": false},
           {"key": "sounds_enabled", "value": true, "ok": true},
           {"key": "style_email", "value": "very casual", "ok": "very_casual"},
           {"key": "paste_method", "value": "xdotool", "ok": "xdotool"},
           {"key": "meeting_default_template", "value": "Standup", "ok": "standup"},
           {"key": "polish_hotkey", "value": "off", "ok": ""},
           {"key": "hotkey", "value": "alt_r", "ok": "alt_r"},
           {"key": "cleanup_level", "value": "extreme", "error": true},
           {"key": "server_port", "value": "9000", "error": true},
           {"key": "llm_base_url", "value": "http://evil.example", "error": true},
           {"key": "paste_method", "value": "osascript", "error": true},
           {"key": "meeting_default_template", "value": "nonexistent", "error": true},
           {"key": "sounds_enabled", "value": "maybe", "error": true},
           {"key": "hotkey", "value": "off", "error": true},
           {"key": "style_work", "value": null, "error": true},
           {"key": "cleanup_level", "value": "mediummediummediummediummediummediummediummediummediummediummedium", "error": true}
         ]},
        {"id": "set-apply-undo", "kind": "apply_undo", "gate": "S4", "platform": "linux", "templates": ["general", "standup", "one-on-one"]},
        {"id": "set-change-warning", "kind": "change_warning", "gate": "S4",
         "cases": [
           {"name": "requested-level", "change": {"kind": "setting", "key": "cleanup_level", "before": "light", "value": "medium"},
            "request": "set cleanup to medium", "eq": ""},
           {"name": "requested-switch-off", "change": {"kind": "setting", "key": "sounds_enabled", "before": true, "value": false},
            "request": "turn off sounds", "contains": ["turns", "off"], "not_contains": ["doesn't seem to mention"]},
           {"name": "unrequested-switch-off", "change": {"kind": "setting", "key": "work_prompts", "before": true, "value": false},
            "request": "turn off sounds", "contains": ["doesn't seem to mention"]},
           {"name": "unrequested-style", "change": {"kind": "setting", "key": "style_email", "before": "formal", "value": "casual"},
            "request": "set cleanup to medium", "contains": ["doesn't seem to mention"]},
           {"name": "shortcut-change", "change": {"kind": "setting", "key": "hotkey", "before": "alt_l", "value": "alt_r"},
            "request": "change my dictation key to right option", "contains": ["keyboard shortcut"], "not_contains": ["doesn't seem to mention"]},
           {"name": "cleanup-none", "change": {"kind": "setting", "key": "cleanup_level", "before": "light", "value": "none"},
            "request": "set cleanup level to none", "contains": ["turns Cleanup off"]},
           {"name": "requested-word", "change": {"kind": "word", "word": "Qdrant"}, "request": "add Qdrant to my dictionary", "eq": ""},
           {"name": "unrequested-word", "change": {"kind": "word", "word": "Kubernetes"}, "request": "add Qdrant to my dictionary",
            "contains": ["doesn't seem to mention"]},
           {"name": "requested-replacement", "change": {"kind": "replacement", "spoken": "post gres", "written": "PostgreSQL"},
            "request": "replace post gres with PostgreSQL", "eq": ""},
           {"name": "forged-object", "change": {"kind": "forged"}, "request": "anything", "eq": "Not valid: preview again."},
           {"name": "non-allowlisted-key", "change": {"kind": "raw", "key": "server_port", "before": 8756, "value": 9000},
            "request": "change the server port", "eq": "Not valid: preview again."}
         ]}
      ]
    }
  }
