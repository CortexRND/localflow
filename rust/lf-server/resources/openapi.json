      "post": {
        "summary": "Api Speakers Enroll",
        "description": "Enroll a voice: JSON ``{name, meeting_id, speaker_id}`` from a meeting saved with\nrecognition on, or multipart ``file`` + ``name`` (local only; the audio is not retained:\nit is decoded in memory, except that an M4A/MP4 needing seeking gets a short-lived private\ntemporary copy, deleted right after decoding). The gate is checked before the body is\nread.",
        "operationId": "api_speakers_enroll_api_speakers_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "title": "Enroll From Meeting",
                "required": [
                  "name",
                  "meeting_id",
                  "speaker_id"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "title": "Name"
                  },
                  "meeting_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{32}$",
                    "title": "Meeting Id"
                  },
                  "speaker_id": {
                    "type": "string",
                    "title": "Speaker Id"
                  }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "title": "Enroll From Audio",
                "required": [
                  "name",
                  "file"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "title": "Name"
                  },
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "title": "File"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Api Speakers Enroll Api Speakers Post"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Api Speakers Forget All",
        "description": "Forget every voice and erase all stored voice data from meeting speaker data.",
        "operationId": "api_speakers_forget_all_api_speakers_delete",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Api Speakers Forget All Api Speakers Delete"
                }
              }
            }
          }
        }
      }
    },
