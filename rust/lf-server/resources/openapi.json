        ],
        "title": "MeetingChat"
      },
      "MeetingNotes": {
        "properties": {
          "notes": {
            "type": "string",
            "title": "Notes"
          }
        },
        "type": "object",
        "required": [
          "notes"
        ],
        "title": "MeetingNotes"
      },
      "MeetingStart": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "title": "Title",
            "default": "Meeting"
          },
          "category": {
            "type": "string",
            "title": "Category",
            "default": ""
          },
          "template": {
            "type": "string",
            "title": "Template",
            "default": ""
          },
          "user_notes": {
            "type": "string",
            "title": "User Notes",
            "default": ""
          },
          "auto_title": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Auto Title"
          }
        },
        "type": "object",
        "title": "MeetingStart"
      },
      "RecallRequest": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question"
          },
          "since": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Since"
          },
          "k": {
            "type": "integer",
            "title": "K",
            "default": 8
          },
